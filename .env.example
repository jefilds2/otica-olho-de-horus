# --------------------------------------------------
# Banco de dados MariaDB
# --------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --------------------------------------------------
# API Node/Express
# --------------------------------------------------
PORT=3000
JWT_SECRET=

# Desenvolvimento local do frontend
FRONTEND_URL=http://localhost:5173

# URL publica do site em producao
FRONTEND_PUBLIC_URL=https://oticaolhodehorus.com.br

# URL da API consumida pelo frontend
VITE_API_URL=http://localhost:3000

# URL publica do backend para webhooks e callbacks
BACKEND_PUBLIC_URL=

# Pasta de uploads persistente.
# Em hospedagens com "public_html" ao lado da app Node, pode usar ../public_html/uploads
# Se nao definir, o sistema tenta usar ../public_html/uploads automaticamente quando existir.
UPLOADS_DIR=

# Origens permitidas no CORS
CORS_ALLOWED_ORIGINS=https://oticaolhodehorus.com.br,https://www.oticaolhodehorus.com.br,http://localhost:5173

# --------------------------------------------------
# Mercado Pago
# --------------------------------------------------
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# --------------------------------------------------
# Melhor Envio
# --------------------------------------------------
MELHOR_ENVIO_BASE_URL=https://melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=Otica Olho de Horus (contato@oticaolhodehorus.com.br)
MELHOR_ENVIO_PUBLIC_URL=
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_APP_NAME=Olho de Horus
MELHOR_ENVIO_TECHNICAL_EMAIL=
MELHOR_ENVIO_AGENCY=

# --------------------------------------------------
# Origem da loja para calculo de frete
# --------------------------------------------------
STORE_NAME=Otica Olho de Horus
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=
STORE_CNPJ=
STORE_STATE_REGISTER=ISENTO
STORE_ORIGIN_POSTAL_CODE=
STORE_ORIGIN_ADDRESS=
STORE_ORIGIN_NUMBER=
STORE_ORIGIN_DISTRICT=
STORE_ORIGIN_CITY=
STORE_ORIGIN_STATE=

# --------------------------------------------------
# Pacote padrao para cotacao de frete
# --------------------------------------------------
DEFAULT_PACKAGE_WEIGHT=0.4
DEFAULT_PACKAGE_WIDTH=16
DEFAULT_PACKAGE_HEIGHT=6
DEFAULT_PACKAGE_LENGTH=18
